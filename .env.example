# Seller dashboard: secret address and login (see src/proxy.ts). Without ADMIN_PATH the dashboard is unreachable.
ADMIN_PATH=choose-a-long-random-word
ADMIN_USER=vendeur
ADMIN_PASSWORD=
# Starting value for the seller's WhatsApp number (editable in the dashboard)
NEXT_PUBLIC_SELLER_PHONE=

# Firestore project. Without it the store runs on built-in demo data (local development only).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase service account (server only, REQUIRED with a project id): the only way into the
# database, since firestore.rules refuse every other request. Set it for Production AND Preview.
# Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# WhatsApp Cloud API (Meta). See README "WhatsApp". Switch it on in the dashboard (Paramètres).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# Optional, default v25.0
WHATSAPP_API_VERSION=

# Local testing only: point the server at the Firestore emulator instead of the live database
# (no service account needed). `node scripts/seed-firestore.mjs` fills it and refuses to run without it.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
