rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Store settings & branding
    match /settings/{docId} {
      allow read, write: if true;
    }
    // Delivery zones
    match /cities/{docId} {
      allow read, write: if true;
    }
    // Catalog categories
    match /categories/{docId} {
      allow read, write: if true;
    }
    // Product catalog & stock
    match /products/{docId} {
      allow read, write: if true;
    }
    // WhatsApp bookkeeping (contacts, processed message ids): server only, via the service account
    match /wa_contacts/{docId} {
      allow read, write: if false;
    }
    match /wa_inbound/{docId} {
      allow read, write: if false;
    }
    match /wa_messages/{docId} {
      allow read, write: if false;
    }
    // Orders & tracking
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
