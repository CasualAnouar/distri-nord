rules_version = '2';

// Nobody reaches the database from a browser or with the public project id. The website's server
// reads and writes everything with its service account (src/lib/firebase-admin.ts), which these
// rules do not apply to. Customer orders (names, phones, addresses) are therefore private.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
